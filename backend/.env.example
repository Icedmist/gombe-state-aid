# PostgreSQL (must match docker-compose service `db`)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/gombe_summit
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@db:5432/gombe_summit
# Local dev override (no docker):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5434/gombe_summit
# SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5434/gombe_summit

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@gombe-summit.ng

REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/uploads
FRONTEND_URL=http://localhost:3000
